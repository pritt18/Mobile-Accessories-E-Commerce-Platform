# Server
PORT=5000
NODE_ENV=development

# Database - put your MySQL connection string here
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/mobixia_db"

# JWT - use any long random string
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=7d

# 32-byte hex key for AES-256-GCM encryption of payment credentials
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_key_here

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Email / SMTP Service (Gmail, SendGrid, Brevo, or cPanel SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Mobixia Support <your_email@gmail.com>"

# Razorpay Online Payment Gateway
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
